<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.maxkb4j.system.mapper.UserMapper">

    <!-- 用户名下自有资源数量：应用/知识库/模型/工具，删除用户前校验 -->
    <select id="countOwnedResource" resultType="long">
        SELECT
        (SELECT count(*) FROM application WHERE "user_id" = #{userId})
        + (SELECT count(*) FROM knowledge WHERE "user_id" = #{userId})
        + (SELECT count(*) FROM model WHERE "user_id" = #{userId})
        + (SELECT count(*) FROM tool WHERE "user_id" = #{userId})
    </select>

    <!-- 删除用户创建的应用 API Key（外键引用用户，删除用户前清理） -->
    <delete id="deleteApplicationApiKeyByUserIds">
        DELETE FROM "application_api_key" WHERE "user_id" IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>
</mapper>
