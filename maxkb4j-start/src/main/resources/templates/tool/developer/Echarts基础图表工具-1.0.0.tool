{"code":"import com.alibaba.fastjson.JSONArray;\nimport com.alibaba.fastjson.JSONObject;\n\nimport java.util.List;\n\npublic static String generateEChartsHtml(List<?> xAxisData, List<?> yAxisData, String chartTitle, String chartType) {\n    // 1. 直接使用传入的集合，无需再解析JSON字符串\n    // fastjson 在序列化时会自动将 List 转为 JSON 数组\n\n    // 2. 构建 style 对象\n    JSONObject style = new JSONObject();\n    style.put(\"height\", \"400px\");\n    style.put(\"width\", \"100%\");\n\n    // 3. 构建 title 对象\n    JSONObject title = new JSONObject();\n    title.put(\"text\", chartTitle);\n    title.put(\"left\", \"center\");\n\n    // 4. 初始化 option 对象\n    JSONObject option = new JSONObject();\n    option.put(\"title\", title);\n\n    // 5. 构建 series 对象\n    JSONObject series = new JSONObject();\n    series.put(\"type\", chartType);\n\n    // 6. 根据图表类型进行不同配置\n    JSONObject tooltip = new JSONObject();\n    if (!\"pie\".equals(chartType)) {\n        // --- 非饼图配置 (如折线图、柱状图) ---\n\n        // 配置 xAxis（直接放入List，fastjson会自动序列化为JSON数组）\n        JSONObject xAxis = new JSONObject();\n        xAxis.put(\"type\", \"category\");\n        xAxis.put(\"boundaryGap\", false);\n        xAxis.put(\"data\", xAxisData);\n\n        // 配置 yAxis\n        JSONObject yAxis = new JSONObject();\n        yAxis.put(\"type\", \"value\");\n\n        // 配置 markPoint (最大值/最小值)\n        JSONObject markPointDataMax = new JSONObject();\n        markPointDataMax.put(\"type\", \"max\");\n        markPointDataMax.put(\"name\", \"最大值\");\n\n        JSONObject markPointDataMin = new JSONObject();\n        markPointDataMin.put(\"type\", \"min\");\n        markPointDataMin.put(\"name\", \"最小值\");\n\n        JSONArray markPointDataArray = new JSONArray();\n        markPointDataArray.add(markPointDataMax);\n        markPointDataArray.add(markPointDataMin);\n\n        JSONObject onlineMarkPoint = new JSONObject();\n        onlineMarkPoint.put(\"data\", markPointDataArray);\n\n        // 组装 series（直接放入List）\n        series.put(\"data\", yAxisData);\n        series.put(\"markPoint\", onlineMarkPoint);\n\n        // 将 xAxis 和 yAxis 添加到 option\n        option.put(\"xAxis\", xAxis);\n        option.put(\"yAxis\", yAxis);\n\n        // 设置 tooltip 触发方式\n        tooltip.put(\"trigger\", \"axis\");\n\n    } else {\n        // --- 饼图配置 ---\n        JSONArray seriesData = new JSONArray();\n        // 注意：这里假设xAxisData和yAxisData的长度是一致的\n        for (int i = 0; i < xAxisData.size(); i++) {\n            JSONObject dataItem = new JSONObject();\n            dataItem.put(\"value\", yAxisData.get(i));\n            dataItem.put(\"name\", xAxisData.get(i));\n            seriesData.add(dataItem);\n        }\n        series.put(\"data\", seriesData);\n\n        // 设置 tooltip 触发方式\n        tooltip.put(\"trigger\", \"item\");\n    }\n\n    // 7. 将 tooltip 和 series 添加到 option\n    option.put(\"tooltip\", tooltip);\n    JSONArray seriesArray = new JSONArray();\n    seriesArray.add(series);\n    option.put(\"series\", seriesArray);\n\n    // 8. 构建最终的 formSetting 对象\n    JSONObject formSetting = new JSONObject();\n    formSetting.put(\"actionType\", \"JSON\");\n    formSetting.put(\"style\", style);\n    formSetting.put(\"option\", option);\n\n    // 9. 将最终对象转换为字符串并包装在HTML标签中\n    return \"<echarts_render>\" + JSONObject.toJSONString(formSetting) + \"</echarts_render>\";\n}\n\nreturn generateEChartsHtml(xAxis,yAxis,chartTitle,chartType)","createTime":1784773373648,"desc":"Echarts基础图表工具 饼状图、柱状图、折线图","folderId":"default","icon":"./tool/echarts/icon.png","id":"1f850c721a4e1dca4fa7b627044a3ce3","initFieldList":[{"field":"chartType","option_list":[{"label":"折线图","value":"line"},{"label":"柱状图","value":"bar"},{"label":"饼图","value":"pie"}],"input_type":"SingleSelect","text_field":"label","value_field":"value","default_value":"line","label":{"input_type":"TooltipLabel","label":"chartType","props_info":{},"attrs":{"tooltip":"图表类型"}},"required":true,"show_default_value":true,"attrs":{}}],"initParams":{"chartType":"line"},"inputFieldList":[{"desc":"","isRequired":true,"name":"chartTitle","source":"reference","type":"string"},{"desc":"","isRequired":true,"name":"xAxis","source":"reference","type":"array"},{"desc":"","isRequired":true,"name":"yAxis","source":"reference","type":"array"}],"isActive":true,"label":"developer","name":"Echarts基础图表工具","scope":"WORKSPACE","toolType":"CUSTOM","updateTime":1788604036845,"userId":"7d6a71016b3c6ea26370dc902019c57a"}