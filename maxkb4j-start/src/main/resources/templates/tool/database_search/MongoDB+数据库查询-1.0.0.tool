{"code":"import com.mongodb.client.MongoClients;\nimport com.mongodb.client.MongoClient;\nimport com.mongodb.client.MongoDatabase;\nimport com.mongodb.client.MongoCollection;\nimport org.bson.Document;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\npublic static String queryMongoDB(String host, int port, String user, String password, String database, String collection, String query) {\n    // 构建连接字符串（带认证）\n    String connectionString = String.format(\"mongodb://%s:%s@%s:%s/?authSource=admin\", user, password, host, port);\n\n    try (MongoClient client = MongoClients.create(connectionString)) {\n        MongoDatabase db = client.getDatabase(database);\n        MongoCollection<Document> col = db.getCollection(collection);\n\n        // 解析查询条件\n        Document queryDoc = Document.parse(query);\n\n        // 执行查询\n        List<Document> results = new ArrayList<>();\n        col.find(queryDoc).forEach(results::add);\n\n        // 转换为 JSON 字符串返回\n        StringBuilder sb = new StringBuilder(\"[\");\n        for (int i = 0; i < results.size(); i++) {\n            sb.append(results.get(i).toJson());\n            if (i < results.size() - 1) sb.append(\",\");\n        }\n        sb.append(\"]\");\n        return sb.toString();\n\n    } catch (Exception e) {\n        throw new RuntimeException(\"Error while connecting to MongoDB: \" + e.getMessage(), e);\n    }\n}","desc":"执行MongoDB查询。query 参数必须是 MongoDB JSON 过滤条件（例如 {\"name\":\"张三\"} 或 {}），禁止传入 db.collection.find(...) 这类 mongo shell 语句","inputFieldList":[{"desc":"MongoDB 服务主机地址","label":"主机地址","name":"host","required":true,"type":"string"},{"desc":"MongoDB 服务端口","label":"端口","name":"port","required":true,"type":"number"},{"desc":"MongoDB 认证用户名","label":"用户名","name":"user","required":true,"type":"string"},{"desc":"MongoDB 认证密码","label":"密码","name":"password","required":true,"type":"string"},{"desc":"要查询的数据库名称","label":"数据库","name":"database","required":true,"type":"string"},{"desc":"要查询的集合名称","label":"集合","name":"collection","required":true,"type":"string"},{"desc":"MongoDB JSON 过滤条件（Extended JSON），例如 {\"name\":\"张三\"}、{\"age\":{\"$gt\":18}}，查全部传 {}；不要传 db.collection.find(...) 等 shell 语句","label":"查询条件","name":"query","required":true,"type":"string"}],"script":"@Grab('org.mongodb:mongodb-driver-sync:4.11.1')\nimport com.mongodb.client.MongoClients\nimport com.mongodb.client.MongoClient\nimport com.mongodb.client.MongoCollection\nimport com.mongodb.client.MongoDatabase\nimport org.bson.Document\nimport org.bson.types.ObjectId\nimport groovy.json.JsonBuilder\nimport groovy.json.JsonOutput\n\nimport java.time.format.DateTimeFormatter\nimport java.time.Instant\nimport java.time.ZoneId\n\n// ========== 查询条件归一化 ==========\n// query 期望是 MongoDB JSON 过滤条件（如 {\"name\":\"张三\"}），但大模型/上游节点经常误传\n// mongo shell 语句（如 db.user.find({\"name\":\"张三\"}).limit(10)），Document.parse 只认 JSON，\n// 会抛 \"JSON reader was expecting a value but found 'db'\"。\n// 以下闭包把 shell 语句拆解为 filter / projection / sort / limit / skip。\n\n// 扫描文本，提取所有顶层平衡的 {...} 或 [...] 片段（跳过字符串字面量与转义符）\ndef extractJsonBlocks = { String text ->\n    def blocks = []\n    int depth = 0\n    int start = -1\n    boolean inString = false\n    boolean escaped = false\n    int len = text.length()\n    for (int i = 0; i < len; i++) {\n        String ch = text.substring(i, i + 1)\n        if (inString) {\n            if (escaped) {\n                escaped = false\n            } else if ('\\\\'.equals(ch)) {\n                escaped = true\n            } else if ('\"'.equals(ch)) {\n                inString = false\n            }\n            continue\n        }\n        if ('\"'.equals(ch)) {\n            inString = true\n        } else if ('{'.equals(ch) || '['.equals(ch)) {\n            if (depth == 0) {\n                start = i\n            }\n            depth = depth + 1\n        } else if ('}'.equals(ch) || ']'.equals(ch)) {\n            depth = depth - 1\n            if (depth == 0 && start >= 0) {\n                def block = new LinkedHashMap()\n                block.put(\"start\", start)\n                block.put(\"json\", text.substring(start, i + 1))\n                blocks << block\n                start = -1\n            }\n        }\n    }\n    return blocks\n}\n\n// 取 keyword 之后出现的第一个 JSON 片段，没有则返回 null\ndef blockAfter = { String text, List blocks, String keyword ->\n    int idx = text.indexOf(keyword)\n    if (idx < 0) {\n        return null\n    }\n    for (int i = 0; i < blocks.size(); i++) {\n        def block = blocks.get(i)\n        if (block.get(\"start\") > idx) {\n            return block.get(\"json\").toString()\n        }\n    }\n    return null\n}\n\n// 取 keyword 之后出现的第一个整数，没有则返回 null\ndef numberAfter = { String text, String keyword ->\n    int idx = text.indexOf(keyword)\n    if (idx < 0) {\n        return null\n    }\n    String tail = text.substring(idx + keyword.length())\n    String digits = \"\"\n    int tailLen = tail.length()\n    for (int i = 0; i < tailLen; i++) {\n        String ch = tail.substring(i, i + 1)\n        if ('0123456789'.contains(ch)) {\n            digits = \"${digits}${ch}\"\n        } else {\n            break\n        }\n    }\n    if (digits.isEmpty()) {\n        return null\n    }\n    return Integer.valueOf(digits)\n}\n\n// 解析查询条件：兼容 Map、标准 JSON 过滤文档、mongo shell 语句三种写法\nDocument queryDoc\nDocument projectionDoc = null\nDocument sortDoc = null\nInteger limitNum = null\nInteger skipNum = null\n\nif (query instanceof Map) {\n    queryDoc = new Document(query)\n} else {\n    String qStr = query == null ? \"\" : query.toString().trim()\n    if (qStr.isEmpty()) {\n        qStr = \"{}\"\n    }\n    if (qStr.startsWith(\"{\")) {\n        queryDoc = Document.parse(qStr)\n    } else if (qStr.startsWith(\"[\")) {\n        throw new IllegalArgumentException(\"query 不支持聚合管道写法，请传入 JSON 过滤条件，例如 {\\\"name\\\":\\\"张三\\\"}；当前输入：${qStr}\")\n    } else {\n        def blocks = extractJsonBlocks(qStr)\n        if (blocks.size() == 0) {\n            throw new IllegalArgumentException(\"query 必须是 MongoDB JSON 过滤条件（例如 {\\\"name\\\":\\\"张三\\\"} 或 {}），请勿传入 db.xxx.find(...) 这类 shell 语句；当前输入无法解析：${qStr}\")\n        }\n        String filterJson = blockAfter(qStr, blocks, \"find(\")\n        if (filterJson == null) {\n            filterJson = blockAfter(qStr, blocks, \"findOne(\")\n        }\n        if (filterJson == null) {\n            filterJson = blocks.get(0).get(\"json\").toString()\n        }\n        if (filterJson.startsWith(\"[\")) {\n            throw new IllegalArgumentException(\"query 不支持聚合管道写法，请传入 JSON 过滤条件，例如 {\\\"name\\\":\\\"张三\\\"}；当前输入：${qStr}\")\n        }\n        queryDoc = Document.parse(filterJson)\n\n        // find(filter, projection) 的第二个参数：紧跟 filter 之后且中间没有 ')'\n        int filterIdx = qStr.indexOf(filterJson)\n        int filterEnd = filterIdx + filterJson.length()\n        for (int i = 0; i < blocks.size(); i++) {\n            def block = blocks.get(i)\n            def blockStart = block.get(\"start\")\n            if (blockStart >= filterEnd) {\n                String between = qStr.substring(filterEnd, blockStart)\n                if (!between.contains(\")\")) {\n                    projectionDoc = Document.parse(block.get(\"json\").toString())\n                }\n                break\n            }\n        }\n\n        String sortJson = blockAfter(qStr, blocks, \".sort(\")\n        if (sortJson != null) {\n            sortDoc = Document.parse(sortJson)\n        }\n        limitNum = numberAfter(qStr, \".limit(\")\n        skipNum = numberAfter(qStr, \".skip(\")\n    }\n}\n\nMongoClient client = null\ntry {\n    // 构建连接字符串（带认证）\n    String connectionString = \"mongodb://${user}:${password}@${host}:${port}/?authSource=admin\"\n    client = MongoClients.create(connectionString)\n\n    MongoDatabase db = client.getDatabase(database)\n    MongoCollection<Document> col = db.getCollection(collection)\n\n    // 执行查询\n    def iterable = col.find(queryDoc)\n    if (projectionDoc != null) {\n        iterable = iterable.projection(projectionDoc)\n    }\n    if (sortDoc != null) {\n        iterable = iterable.sort(sortDoc)\n    }\n    if (skipNum != null) {\n        iterable = iterable.skip(skipNum)\n    }\n    if (limitNum != null) {\n        iterable = iterable.limit(limitNum)\n    }\n\n    def results = []\n    iterable.forEach { doc ->\n        // 转换 ObjectId 为字符串\n        if (doc.containsKey(\"_id\") && doc.get(\"_id\") instanceof ObjectId) {\n            doc.put(\"_id\", doc.get(\"_id\").toString())\n        }\n\n        // 处理二进制数据（bytes） -> UTF-8 字符串\n        doc.each { key, value ->\n            if (value instanceof byte[]) {\n                doc.put(key, new String(value, \"UTF-8\"))\n            }\n        }\n\n        results << doc\n    }\n\n    // 自定义序列化：处理 Date、Instant 等\n    def serialize = { obj ->\n        if (obj == null) return null\n        if (obj instanceof Date) {\n            // 转为 ISO 8601 字符串（带时区）\n            Instant instant = obj.toInstant()\n            return instant.atZone(ZoneId.of(\"UTC\")).format(DateTimeFormatter.ISO_OFFSET_DATE_TIME)\n        }\n        if (obj instanceof byte[]) {\n            return new String(obj, \"UTF-8\")\n        }\n        // 其他类型直接返回（Groovy 的 JsonBuilder 会处理基本类型）\n        return obj\n    }\n\n    // 手动构建 JSON（避免默认的奇怪格式）\n    def jsonBuilder = new JsonBuilder()\n    jsonBuilder.call(results.collect { doc ->\n        doc.collectEntries { k, v ->\n            [(k): serialize(v)]\n        }\n    })\n\n    return JsonOutput.prettyPrint(jsonBuilder.toString())\n\n} catch (Exception e) {\n    println(\"Error while querying MongoDB: ${e.message}\")\n    throw e\n} finally {\n    if (client) {\n        client.close()\n    }\n}"}
