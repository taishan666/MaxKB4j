{"code":"import io.github.mymonstercat.ocr.InferenceEngine;\nimport io.github.mymonstercat.Model;\nimport com.benjaminwan.ocrlibrary.OcrResult;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.LinkedList;\r\nimport com.maxkb4j.common.util.SpringUtil;\r\nimport com.maxkb4j.oss.service.IOssService;\r\n\nInferenceEngine engine = InferenceEngine.getInstance(Model.ONNX_PPOCR_V4)\n\nList<String> contentList = new LinkedList<>()\nList<Path> tempFiles = new LinkedList<>()\r\nIOssService ossService=SpringUtil.getBean(IOssService.class);\n\ntry {\n    imageList.each { file ->\n        byte[] fileBytes = ossService.getBytes(file.fileId)\n        \n        // 直接创建临时文件（无需先建目录）\n        Path tempFile = Files.createTempFile(\"ocr-\", \".tmp\")\n        tempFiles.add(tempFile)  // 记录以便清理\n        \n        Files.write(tempFile, fileBytes)\n        \n        OcrResult result = engine.runOcr(tempFile.toString());\n        contentList.add(result?.strRes ?: \"\")  // 防止 null\n    }\n    \n    return String.join(\"\\n\", contentList)\n    \n} catch (Exception e) {\n    e.printStackTrace()\n} finally {\n    // 清理所有临时文件\n    tempFiles.each { path ->\n        try {\n            Files.deleteIfExists(path)\n        } catch (Exception ex) {\n            // 忽略删除失败（如已被删或权限问题）\n        }\n    }\n}","createTime":1788409574687,"desc":"本地识别图片文字工具","folderId":"default","icon":"./tool/rapid_ocr/icon.png","id":"3cbd966409a1a1585339150bc54a8e3e","initFieldList":[],"inputFieldList":[{"isRequired":true,"name":"imageList","source":"reference","type":"array"}],"isActive":true,"label":"content_handle","name":"Rapid-OCR图片识别","scope":"WORKSPACE","toolType":"CUSTOM","updateTime":1788409576760,"userId":"7d6a71016b3c6ea26370dc902019c57a"}